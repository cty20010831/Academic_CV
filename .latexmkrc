$pdf_mode = 1;                            # generate PDF via pdflatex
$bibtex_use = 2;                          # run biber/bibtex even when .bbl exists
$biber = 'biber %O %B';                   # use biber (required by biblatex)
$jobname = 'Academic_CV_Tianyue_Cong';    # output PDF filename
$clean_ext = 'run.xml synctex.gz';
